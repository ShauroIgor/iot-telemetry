                "initial": {
                  "code": "console.log(context.panel.data, context.panel.response, context.panel.initial, context.panel.elements);\n\nreturn;\n\n/**\nData Source\nRequires form elements to be defined\n */\nconst dataQuery = context.utils.toDataQueryResponse(context.panel.response);\nconsole.log(dataQuery);",
                  "contentType": "application/json",
                  "getPayload": "return {}",
                  "highlight": false,
                  "highlightColor": "red",
                  "method": "-",
                  "payload": {}
                },
                "layout": {
