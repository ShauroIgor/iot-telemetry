                "submit": {
                  "backgroundColor": "purple",
                  "foregroundColor": "yellow",
                  "icon": "check",
                  "text": "Approve",
                  "variant": "destructive"
                },
                "sync": false,
                "update": {
                  "code": "const macEl = context.panel.elements.find((el) => el.id === 'macAddress');\nconst mac = macEl ? (macEl.value || '').trim() : '';\n\nif (!mac) {\n  context.grafana.notifyError(['Approve Device', 'Enter a MAC address first.']);\n  return;\n}\n\nconst body = {\n  queries: [\n    {\n      refId: 'A',\n      datasource: { type: 'yesoreyeram-infinity-datasource', uid: 'TelemetryAdminAPI' },\n      type: 'json',\n      source: 'url',\n      format: 'table',\n      parser: 'backend',\n      url: '/telemetry/devices/' + encodeURIComponent(mac) + '/approve',\n      url_options: { method: 'POST', data: '', body_type: 'none' }\n    }\n  ]\n};\n\nfetch('/api/ds/query', {\n  method: 'POST',\n  headers: { 'Content-Type': 'application/json' },\n  credentials: 'same-origin',\n  body: JSON.stringify(body)\n}).then(async (res) => {\n  const json = await res.json().catch(() => ({}));\n  const result = json && json.results ? json.results.A : undefined;\n  if (res.ok && result && !result.error) {\n    context.grafana.notifySuccess(['Approve Device', 'Device approved: ' + mac]);\n    context.grafana.refresh();\n  } else {\n    const message = (result && result.error) || ('HTTP ' + res.status);\n    context.grafana.notifyError(['Approve Device', 'Failed: ' + message]);\n  }\n}).catch((err) => {\n  context.grafana.notifyError(['Approve Device', 'Request failed: ' + err.message]);\n});",
                  "confirm": false,
                  "contentType": "application/json",
                  "getPayload": "const payload = {};\ncontext.panel.elements.forEach((element) => {\n  if (!element.value) {\n    return;\n  }\n  payload[element.id] = element.value;\n})\nreturn payload;",
                  "method": "-",
                  "payload": {},
                  "payloadMode": "all",
                  "type": "-"
                },
